# extendgo Workspace DNA (swdt)
workspace_name = "extendgo"
promotion_silo = "00flow"
promotion_ready = "no"
read_only = false
build = true
live = true

Domain "00000-constitution" {
    Subgroup "authority" {
        Entry "01000-mission-purpose" .
        Entry "03000-pulse-progress" .
        Entry "04000-daily-chronicles" .
        Entry "08000-attestation-snapshot" .
    }
}
Domain "81000-active-source" {
    Subgroup "development" {
        Entry "cmd" .
        Entry "pkg" .
    }
}
