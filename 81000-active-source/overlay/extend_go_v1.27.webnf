# ==============================================================================
# REALIZED SOVEREIGN GO EXTENSIONS SPECIFICATION (extend_go_v1.27.webnf)
# Upstream Target: Go v1.27
# Grammar Conformance: go_extensions.wag (grammar_go_extension_spec.wag)
# Domain: Sovereign Systems, Supercomputing & High-Precision Science
# Active Extensions: 5 | Subsumed Upstream Features: 1
# ==============================================================================

:com:velocikey:extendgo:go_extensions_v1_27

# --- Realized Extension Metadata ---
ExtensionMetadata = "name" ":" "ExtendGo_v1.27"
                  / "target_language" ":" "go"
                  / "base_version" ":" "1.27"
                  / "description" ":" "Realized sovereign extensions active for Go v1.27" ;

# ==============================================================================
# 1. ACTIVE SOVEREIGN EXTENSIONS (Required for Go v1.27)
# ==============================================================================

# --- [1/5] Active Extension: ScalarPrecisionExtension ---
ScalarPrecisionExtension = "target_rule" ":" "BaseType"
                 / "section" ":" "types"
                 / "action" ":" "AUGMENT"
                 / "feature" ":" "SUPERCOMPUTING_SCALARS"
                 / "lifecycle" ":" "ACTIVE"
                 / "subsumed_if" ":" "float128"
                 / ( "float2048" / "float1024" / "float512" / "float256" / "float128" / "complex4096" / "complex2048" / "complex1024" / "complex512" / "complex256" / "int2048" / "int1024" / "int512" / "int256" / "int128" / "uint2048" / "uint1024" / "uint512" / "uint256" / "uint128" / DecimalType ) ;

# --- [2/5] Active Extension: DecimalTypeExtension ---
DecimalTypeExtension = "target_rule" ":" "DecimalType"
                 / "section" ":" "types"
                 / "action" ":" "INJECT"
                 / "feature" ":" "ARBITRARY_PRECISION_DECIMALS"
                 / "lifecycle" ":" "ACTIVE"
                 / "subsumed_if" ":" "decimal["
                 / ( "decimal""["(Number / Identifier)"]" ) ;

# --- [3/5] Active Extension: SelectorExtension ---
SelectorExtension = "target_rule" ":" "Selector"
                 / "section" ":" "expressions"
                 / "action" ":" "REPLACE"
                 / "feature" ":" "CHAINED_GENERIC_SELECTORS"
                 / "lifecycle" ":" "ACTIVE"
                 / "subsumed_if" ":" "TypeArgs"
                 / ( "." Identifier[TypeArgs] ) ;

# --- [4/5] Active Extension: InterfaceMethodConstraint ---
InterfaceMethodConstraint = "target_rule" ":" "InterfaceMethod"
                 / "section" ":" "interfaces"
                 / "action" ":" "FORBID"
                 / "feature" ":" "INTERFACE_METHOD_GENERIC_GUARD"
                 / "lifecycle" ":" "ACTIVE"
                 / "forbid" ":" "TypeParamList"
                 ;

# --- [5/5] Active Extension: ExtraKeywords ---
ExtraKeywords = "action" ":" "REGISTER_KEYWORD"
              / "decimal" ;

# ==============================================================================
# 2. SUBSUMED UPSTREAM FEATURES (NO LONGER NEEDED as of Go v1.27)
# ==============================================================================
