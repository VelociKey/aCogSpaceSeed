# aCogSpaceSeed Root Gitignore

# Large Binary & Scratch Exclusions
*.h5ad
*.tensorbin*
*.wasm
*.exe
*.tmp
*.bin
*.zip
*.tar.gz
*.gose
*/scratch/*
scratch/
data/
exports/

# Transient CLI test & benchmark output captures
out.txt
test_out.txt
*.out

# Ignore everything inside the silo directories
# /000ALL/
# /000all/
# /00flow/
# /86SREF/
# /86sref/
# /00AAIF/
# /00aaif/
# /00xper/
# /13reng/
# /50cove/
# /51slam/
# /00floo/
# /00flob/
# /00flon/
# /99cbox/
# /99cogt/
# /00fora/
# /00cogt/
# /01xpsd/
# /01open/
# /01prod/
# /00taut/
# /00skim/

# Ephemeral Scratch & Hydration Caches (Recursive)
c0990-ephemeral-scratch/
**/c0990-ephemeral-scratch/**
hydrationcache/
**/hydrationcache/**

# Forge Toolchain & Executable Directories
/forge/
/96000-internal-executables/
**/96000-internal-executables/**
**/97000-internal-toolchains/**
**/92000-external-toolchains/**
**/93000-external-libraries/**

# Local runtime model & packaging caches (note: /.gemini/config.json is retained!)
/.gemini/antigravity/
/.gemini/tmp/
/.tensorcore/
/.nvelwraith/
/.lithic/

